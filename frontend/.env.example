# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Laravel API as seen from the BROWSER (public forms, page-view tracking).
# In production behind Nginx this is same-origin: /api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Laravel API as seen from the Next.js SERVER (SSR, admin BFF). In Docker: http://backend/api/v1
API_INTERNAL_URL=http://localhost:8000/api/v1

# Shared secret Laravel uses to trigger on-demand revalidation (POST /api/revalidate)
REVALIDATE_SECRET=change-me

# Set to "true" to serve the admin cookie with the Secure flag (always on in production)
ADMIN_COOKIE_SECURE=false

# Origin that serves uploaded files (/storage/...). Same origin in production behind Nginx.
NEXT_PUBLIC_MEDIA_URL=http://localhost:8000
