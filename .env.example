# Root .env for docker compose (secrets live here, not in the images).
SITE_URL=https://example.com
HTTP_PORT=80

# php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
DB_PASSWORD=change-me-strong-password
REVALIDATE_SECRET=change-me-long-random-string
# Initial super admin password (change it after the first login)
ADMIN_PASSWORD=change-me-admin-password
# Set to false only when testing over plain HTTP
ADMIN_COOKIE_SECURE=true
