# Non-secret production defaults for the Docker stack.
# Secrets (APP_KEY, DB_PASSWORD, ...) come from the root .env via docker-compose.yml.
APP_NAME="Aqua Mineral Water API"
APP_ENV=production
APP_DEBUG=false
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_SUPPORTED_LOCALES=fa,en,ar

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=aqua
DB_USERNAME=aqua

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
REDIS_HOST=redis
REDIS_CLIENT=phpredis

FILESYSTEM_DISK=public
PUBLIC_CACHE_TTL=3600
SANCTUM_TOKEN_EXPIRATION=480

FRONTEND_REVALIDATE_URL=http://frontend:3000/api/revalidate

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="no-reply@example.com"
ADMIN_NAME="Super Admin"
