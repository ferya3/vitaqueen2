APP_NAME="Aqua Mineral Water API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
# Comma separated list of content locales served by the API
APP_SUPPORTED_LOCALES=fa,en,ar

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aqua
DB_USERNAME=aqua
DB_PASSWORD=aqua

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=aqua_cache_
# Seconds that public API responses stay in cache (invalidated automatically on content change)
PUBLIC_CACHE_TTL=3600

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum admin tokens expire after this many minutes (default 8h)
SANCTUM_TOKEN_EXPIRATION=480

# Next.js on-demand revalidation (leave URL empty to disable). Must match REVALIDATE_SECRET in the frontend.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
FRONTEND_REVALIDATE_SECRET=change-me

# Where lead notifications (agency / contact requests) are emailed. Empty = disabled.
LEADS_NOTIFICATION_EMAIL=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Initial super admin created by the seeder (change immediately in production!)
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!2026
